web: bash -c 'BIN=""; for c in ./fleetnode /workspace/fleetnode /app/fleetnode; do [ -x "$c" ] && BIN="$c" && break; done; if [ -z "$BIN" ]; then BIN=$(find / -maxdepth 4 -name fleetnode -type f 2>/dev/null | head -1); fi; if [ -z "$BIN" ]; then echo "BIN NOT FOUND; CWD=$(pwd)"; ls -la; ls -la /workspace 2>/dev/null; sleep 900; fi; echo "starting $BIN"; exec "$BIN"'
